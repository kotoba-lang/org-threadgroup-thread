;; One workspace-local git dependency: org-csa-iot-zigbee, for
;; `ieee802154.mac` — the IEEE 802.15.4 MAC frame Thread's 6LoWPAN
;; adaptation layer rides inside. That repo built the shared MAC layer
;; once (it is CSA-Zigbee's own transport too); this repo composes real
;; 6LoWPAN payloads on top of it rather than re-deriving the MAC frame.
;; Pinned to a commit reachable from org-csa-iot-zigbee's own default
;; branch (`main`); verified with
;; `gh api repos/kotoba-lang/org-csa-iot-zigbee/commits/main --jq .sha`.
{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}org.kotoba-lang/org-csa-iot-zigbee
        {:git/url "https://github.com/kotoba-lang/org-csa-iot-zigbee"
         :git/sha "855d2b0fec4db88aaba9266e06eb560ac2ff4943"
         :deps/root "."}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
